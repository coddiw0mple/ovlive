{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/main.py": {
      "maxDuration": 30,
      "excludeFiles": "{data/**,public/**,pipeline/**,.venv/**,**/__pycache__/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/rebuild",
      "schedule": "30 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/data/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60"
        }
      ]
    },
    {
      "source": "/data/regions/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
